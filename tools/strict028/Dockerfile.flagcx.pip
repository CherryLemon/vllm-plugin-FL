ARG BASE_IMAGE=vllm/vllm-openai:v0.28.0-cu129
FROM ${BASE_IMAGE} AS flagtree
COPY flagtree/flagtree-0.6.0+nv37.dbf18423-cp312-cp312-linux_x86_64.whl /tmp/flagtree-0.6.0+nv37.dbf18423-cp312-cp312-linux_x86_64.whl
RUN echo '14e12e5c33864b37ebad2f1b654546a1472d6abee824633c1120952e30686adf  /tmp/flagtree-0.6.0+nv37.dbf18423-cp312-cp312-linux_x86_64.whl' | sha256sum -c - && \
    python3 -m pip install --no-index --no-deps --target=/opt/flagtree /tmp/flagtree-0.6.0+nv37.dbf18423-cp312-cp312-linux_x86_64.whl

FROM ${BASE_IMAGE}
ARG FL_PLUGIN_VERSION
ARG FL_GEMS_VERSION

COPY wheels/ /opt/fl-wheels/
COPY --from=flagtree /opt/flagtree /opt/flagtree
COPY flagcx-runtime/ /opt/flagcx/
COPY deployment-manifest.json /opt/fl-deployment-manifest.json
RUN test -n "${FL_PLUGIN_VERSION}" && test -n "${FL_GEMS_VERSION}" && \
    test -f /opt/flagcx/build/lib/libflagcx.so && \
    python3 -m venv --system-site-packages /opt/fl-venv && \
    /opt/fl-venv/bin/python -m pip install --no-index --no-deps \
      --find-links /opt/fl-wheels \
      'vllm==0.28.0+empty' "vllm-plugin-fl==${FL_PLUGIN_VERSION}" "flag-gems==${FL_GEMS_VERSION}" \
      'PyYAML==6.0.1' 'packaging==26.3' 'SQLAlchemy==2.0.54' \
      'greenlet==3.5.6' 'typing_extensions==4.16.0'
ENV PATH="/opt/fl-venv/bin:${PATH}" \
    PYTHONPATH=/opt/flagtree \
    LD_LIBRARY_PATH="/usr/local/lib/python3.12/dist-packages/nvidia/nccl/lib:${LD_LIBRARY_PATH}" \
    FLAGCX_PATH=/opt/flagcx \
    VLLM_FL_TP_BACKEND=flagcx \
    VLLM_FL_STRICT028=1 \
    VLLM_PLUGINS=fl \
    VLLM_WORKER_MULTIPROC_METHOD=spawn \
    VLLM_ENGINE_READY_TIMEOUT_S=1800 \
    CUBLAS_WORKSPACE_CONFIG=:4096:8 \
    OPENBLAS_NUM_THREADS=1 \
    OMP_NUM_THREADS=4
RUN /opt/fl-venv/bin/python -c "import importlib.util, triton; from vllm_fl.strict028.bootstrap import validate_host; validate_host(); assert triton.__version__ == '3.7.1' and triton.__file__.startswith('/opt/flagtree/'); assert importlib.util.find_spec('vllm._C') is None; assert importlib.util.find_spec('vllm._C_stable_libtorch') is None"
ENTRYPOINT ["/opt/fl-venv/bin/vllm", "serve"]
